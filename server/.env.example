# URL of the running FastAPI app (local: http://localhost:8000, Render: https://your-fastapi.onrender.com)
FASTAPI_URL=http://localhost:8000

# Allow requests from the React dev server (local) or Vercel URL (production)
WEB_ORIGIN=http://localhost:5173

# Port for this Node server (Render sets this automatically)
PORT=4000

